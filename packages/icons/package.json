{
  "name": "@trix/icons",
  "version": "0.1.0",
  "description": "React animated icon components for trix-icons featuring intentional semantic motion stories",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts --format esm --dts --watch"
  },
  "dependencies": {
    "@trix/core": "0.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "motion": "^11.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "motion": "^11.0.0",
    "react": ">=18.0.0"
  }
}
{
  "name": "trix-icons",
  "version": "0.1.0",
  "description": "Source-distribution CLI installer for trix-icons animated React icon components",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "trix-icons": "./bin/trix.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build && tsup packages/cli/src/index.ts --format esm --out-dir dist && node scripts/bundle-cli-assets.js",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "registry:build": "node scripts/build-registry.js",
    "registry:validate": "node scripts/validate-registry.js",
    "icons:validate": "node scripts/validate-icons.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@11.16.0"
}